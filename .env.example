# Required: deployed pool addresses for cUSDT (Default Market)
# Deployed with: `forge script script/Deploy.s.sol --rpc-url $RPC_URL --broadcast`
NEXT_PUBLIC_DEPOSIT_TOKEN=0x85e5fFCa2db5216849A7D515F8dD0f5b7D8e2838
NEXT_PUBLIC_CYVERA_POOL_ADDRESS=0xBa47BF8b59BbcAFf42Ca657352CE2F466b1e15dF
NEXT_PUBLIC_YIELD_SOURCE_ADDRESS=0xe1699F23031C9CB430124232C1eAb5f20F676C66

# Optional: dedicated cUSDC market addresses
# Deployed with: `forge script script/DeployUSDC.s.sol --rpc-url $RPC_URL --broadcast`
NEXT_PUBLIC_DEPOSIT_TOKEN_USDC=
NEXT_PUBLIC_CYVERA_POOL_ADDRESS_USDC=
NEXT_PUBLIC_YIELD_SOURCE_ADDRESS_USDC=

# Optional: Sepolia RPC (defaults to publicnode if unset)
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional: Zama relayer URL (defaults to the public testnet relayer)
NEXT_PUBLIC_ZAMA_RELAYER_URL=https://relayer.testnet.zama.cloud

# Optional: WalletConnect project ID (public default works for testing)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=21fef48091f12692cad574a6f7753643

# Optional: Etherscan API key for richer history
NEXT_PUBLIC_ETHERSCAN_API_KEY=