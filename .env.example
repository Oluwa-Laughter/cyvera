# Required: deployed pool addresses. Set these after running
# `forge script script/Deploy.s.sol --rpc-url $RPC_URL --broadcast`
NEXT_PUBLIC_DEPOSIT_TOKEN=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_CYVERA_POOL_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_YIELD_SOURCE_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: Sepolia RPC (defaults to publicnode if unset)
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional: Zama relayer URL (defaults to the public testnet relayer)
NEXT_PUBLIC_ZAMA_RELAYER_URL=https://relayer.testnet.zama.cloud

# Optional: WalletConnect project ID (public default works for testing)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=21fef48091f12692cad574a6f7753643

# Optional: Etherscan API key for richer history
NEXT_PUBLIC_ETHERSCAN_API_KEY=