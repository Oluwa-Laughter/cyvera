# Required: deployed pool addresses (set these after running
# `forge script script/Deploy.s.sol --rpc-url $RPC_URL --broadcast`)
NEXT_PUBLIC_DEPOSIT_TOKEN=0xa7dA08FafDC9097Cc0E7D4f113A61e31d7e8e9b0
NEXT_PUBLIC_CYVERA_POOL_ADDRESS=0x892a012A975765796A56Ee8102D847b2C5896b20
NEXT_PUBLIC_YIELD_SOURCE_ADDRESS=0x63BC7333B39794966953289052d751079F4386A4

# Optional: custom RPC (defaults to https://ethereum-sepolia-rpc.publicnode.com)
NEXT_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional: Zama relayer override (defaults to https://relayer.testnet.zama.cloud)
NEXT_PUBLIC_ZAMA_RELAYER_URL=https://relayer.testnet.zama.cloud

# Optional: Etherscan API key for richer history (free tier works)
NEXT_PUBLIC_ETHERSCAN_API_KEY=
